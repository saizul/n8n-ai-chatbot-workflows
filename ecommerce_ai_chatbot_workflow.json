      "parameters": {
        "jsCode": "// Update conversation state in Google Sheets\nconst ctx = $('Parse AI Response').first().json;\n\nconst updatedHistory = [...ctx.conversationHistory];\n// Add AI response to history\nupdatedHistory.push({\n  role: 'assistant',\n  content: ctx.aiResponse\n});\n\n// Determine new order state\nlet newOrderState = ctx.orderState || {};\nif (ctx.orderData) {\n  newOrderState = {\n    stage: ctx.orderData.stage,\n    collected: ctx.orderData.collected || newOrderState.collected || {}\n  };\n}\n\n// If order confirmed, clear the order state\nif (ctx.orderData?.stage === 'confirmed') {\n  newOrderState = {};\n}\n\nreturn [{\n  json: {\n    sender_id: ctx.senderId,\n    channel: ctx.channel,\n    page_id: ctx.pageId || '',\n    conversation_history: JSON.stringify(updatedHistory.slice(-20)),\n    order_state: JSON.stringify(newOrderState),\n    last_contact_time: new Date().toISOString(),\n    followup_sent: 'false',\n    is_new: ctx.isNewConversation\n  }\n}];"
      },
