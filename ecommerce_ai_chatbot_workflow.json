    {
      "parameters": {
        "jsCode": "// Parse AI response & extract ORDER_DATA if present\nconst aiOutput = $input.first().json;\nconst rawResponse = aiOutput.choices?.[0]?.message?.content || aiOutput.message?.content || '';\n\nlet cleanResponse = rawResponse;\nlet orderData = null;\n\n// Extract [ORDER_DATA:{...}] block\nconst orderMatch = rawResponse.match(/\\[ORDER_DATA:(\\{.*?\\})\\]/s);\nif (orderMatch) {\n  try {\n    orderData = JSON.parse(orderMatch[1]);\n    cleanResponse = rawResponse.replace(/\\[ORDER_DATA:\\{.*?\\}\\]/s, '').trim();\n  } catch (e) {\n    // JSON parse failed, ignore\n  }\n}\n\n// Check for handover keywords\nconst handoverKeywords = ['টিমকে জানাচ্ছি', 'এজেন্ট', 'handover', 'যোগাযোগ করবেন'];\nconst needsHandover = handoverKeywords.some(kw => cleanResponse.includes(kw));\n\n// Merge with original context\nconst ctx = $('Build Context').first().json;\n\nreturn [{\n  json: {\n    ...ctx,\n    aiResponse: cleanResponse,\n    orderData,\n    needsHandover,\n    rawAiResponse: rawResponse\n  }\n}];"
      },
