      "parameters": {
        "jsCode": "// ——— Normalize incoming message from Facebook or WhatsApp ———\nconst body = $input.first().json;\n\nlet senderId = '';\nlet messageText = '';\nlet channel = 'unknown';\nlet pageId = '';\n\n// ---- Facebook Messenger ----\nif (body.object === 'page' || body.entry) {\n  channel = 'facebook';\n  const entry = body.entry?.[0];\n  pageId = entry?.id || '';\n  const messaging = entry?.messaging?.[0];\n  senderId = messaging?.sender?.id || '';\n  messageText = messaging?.message?.text || '';\n}\n// ---- WhatsApp Business Cloud API ----\nelse if (body.object === 'whatsapp_business_account' || body.entry?.[0]?.changes) {\n  channel = 'whatsapp';\n  const change = body.entry?.[0]?.changes?.[0]?.value;\n  const waMsg = change?.messages?.[0];\n  senderId = waMsg?.from || '';\n  messageText = waMsg?.text?.body || '';\n  pageId = change?.metadata?.phone_number_id || '';\n}\n\nreturn [{\n  json: {\n    senderId,\n    messageText,\n    channel,\n    pageId,\n    timestamp: Date.now(),\n    rawBody: body\n  }\n}];"
      },
      "id": "normalize-message",
      "name": "Normalize Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 400]
    },
    {
      "parameters": {
        "operation": "get",
        "table": "conversation_state",
        "filters": {
