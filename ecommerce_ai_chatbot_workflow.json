      "id": "get-all-conversations",
      "name": "Get All Conversations",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 800]
    },
    {
      "parameters": {
        "jsCode": "// Filter conversations that need follow-up:\n// - Last contact was 30-120 min ago\n// - No reply since then (we track this via a 'followup_sent' flag)\n// - Conversation was not fully resolved\n\nconst now = Date.now();\nconst thirtyMin = 30 * 60 * 1000;\nconst twoHours = 120 * 60 * 1000;\n\nconst rows = $input.all();\nconst needFollowUp = [];\n\nfor (const row of rows) {\n  const r = row.json;\n  if (!r.sender_id || !r.last_contact_time) continue;\n\n  const lastContact = new Date(r.last_contact_time).getTime();\n  const timeSince = now - lastContact;\n  const followupSent = r.followup_sent === 'true' || r.followup_sent === true;\n  const orderState = JSON.parse(r.order_state || '{}');\n  const isCompleted = orderState.stage === 'confirmed' || !orderState.stage;\n\n  // Send follow-up if: 30-120 min gap, not yet sent, not completed\n  if (timeSince >= thirtyMin && timeSince <= twoHours && !followupSent && !isCompleted) {\n    needFollowUp.push({\n      json: {\n        senderId: r.sender_id,\n        channel: r.channel,\n        orderState,\n        rowData: r\n      }\n    });\n  }\n}\n\nreturn needFollowUp.length > 0 ? needFollowUp : [{ json: { skip: true } }];"
      },
      "id": "filter-followup",
