      "id": "get-conversation-state",
      "name": "Get Conversation State",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [860, 400],
      "notes": "Stores conversation history & order collection state. Replace with your DB (Postgres/Airtable/Supabase)."
    },
    {
      "parameters": {
        "jsCode": "// Build conversation context\nconst current = $('Normalize Message').first().json;\nconst stateRows = $input.all();\n\nlet conversationHistory = [];\nlet orderState = {};\nlet lastContactTime = null;\n\nif (stateRows.length > 0 && stateRows[0].json.sender_id) {\n  const row = stateRows[0].json;\n  conversationHistory = JSON.parse(row.conversation_history || '[]');\n  orderState = JSON.parse(row.order_state || '{}');\n  lastContactTime = row.last_contact_time;\n}\n\n// Append new message to history\nconversationHistory.push({\n  role: 'user',\n  content: current.messageText\n});\n\n// Keep last 20 messages only\nif (conversationHistory.length > 20) {\n  conversationHistory = conversationHistory.slice(-20);\n}\n\nreturn [{\n  json: {\n    ...current,\n    conversationHistory,\n    orderState,\n    lastContactTime,\n    isNewConversation: stateRows.length === 0 || !stateRows[0].json.sender_id\n  }\n}];"
      },
      "id": "build-context",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 400]
